# ─── Site assistant (/api/chat) ───────────────────────────────────────────
# Set ONE key. Provider is inferred from whichever is present.

# Option A — Google AI Studio. FREE, no card.  https://aistudio.google.com/apikey
# Trade-off: free-tier capacity is uneven; flagship models often return 503.
GEMINI_API_KEY=

# Option B — Anthropic. PAID, no free tier.  https://console.anthropic.com/settings/keys
# Best quality and no capacity problems. Roughly $1-3/month at realistic
# portfolio traffic; your globalPerDay cap in rate-limit.ts bounds the worst case.
# ANTHROPIC_API_KEY=

# Option C — Groq. FREE, no card.  https://console.groq.com/keys
# Higher daily quota than Gemini and very fast; weaker at nuanced comparison.
# GROQ_API_KEY=

# ─── Optional ─────────────────────────────────────────────────────────────
# LLM_PROVIDER=        # gemini | anthropic | groq — overrides key inference
#
# LLM_MODEL=           # Pins one model. Defaults per provider:
#                      #   gemini     gemini-3.1-flash-lite, then 3.5-flash,
#                      #              then gemini-flash-latest (see note below)
#                      #   anthropic  claude-sonnet-5-5 (claude-haiku-5-5 is cheaper)
#                      #   groq       llama-3.3-70b-versatile
#                      #
#                      # COST NOTE for anthropic: prompt caching has a minimum
#                      # prefix that is NOT consistent across models. Haiku 4.5
#                      # needs 4096 tokens; Sonnet 5.5 needs 512. The system
#                      # prompt is ~3.4K, so it caches on Sonnet and silently
#                      # does NOT on Haiku — making Sonnet 5.5 the CHEAPER of
#                      # the two today. Grow the fact corpus past 4096 tokens
#                      # and Haiku becomes cheapest. Watch the [llm:anthropic]
#                      # log line: cache_read=0 every message means no caching.
#
# LLM_CACHE_TTL=       # "1h" keeps Claude's prompt cache between visitors (writes
#                      # cost 2x instead of 1.25x). Leave unset on a quiet site.
#
# LLM_BASE_URL=        # Point at a proxy or mock server (used in testing).

# ─── PIX's voice (/api/tts) ───────────────────────────────────────────────
# Azure AI Speech, free tier F0: 0.5M characters/month, stops instead of
# charging. Create a "Speech service" resource in the Azure portal, pricing
# tier "Free F0", then copy Key 1 and the Location/Region from "Keys and Endpoint".
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=   # e.g. eastus, centralindia
